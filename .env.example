# ============================================
# Urban Noise Intelligence - Configuration
# ============================================
# Copy this file to .env and modify as needed.
# DO NOT commit .env to version control.
# ============================================

# --- Audio Processing ---
SAMPLE_RATE=22050
AUDIO_DURATION=4.0
N_FFT=2048
HOP_LENGTH=512
N_MELS=128

# --- Data Paths ---
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
METADATA_DIR=data/metadata
URBANSOUND8K_DIR=data/raw/UrbanSound8K

# --- Model ---
MODEL_DIR=models
MODEL_PATH=models/cnn_urban_sound.pth

# --- Database (Phase 6) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/urban_noise
# POSTGIS_ENABLED=true

# --- Kafka (Phase 5) ---
# KAFKA_BROKER=localhost:9092
# KAFKA_TOPIC=urban-noise-events

# --- Backend (Phase 7) ---
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# --- Spatial (Phase 8) ---
# H3_RESOLUTION=8

# --- Anomaly Detection (Phase 9) ---
# ANOMALY_Z_THRESHOLD=2.5

# --- Simulation (Phase 4) ---
# SIMULATION_INTERVAL=2.0
# NUM_SENSORS=5
